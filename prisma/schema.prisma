// ============================================================
// Kiryana Store – Credit & Purchase Management
// Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────
model Admin {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  categories Category[]

  @@map("admins")
}

// ─────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────
model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  adminId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  admin    Admin     @relation(fields: [adminId], references: [id])
  products Product[]
  items    Item[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  items    Item[]

  @@map("products")
}

// ─────────────────────────────────────────────
// UNIT TYPE (enum)
// ─────────────────────────────────────────────
enum UnitType {
  KG
  GRAM
  LITRE
  ML
  PIECE
  DOZEN
  PACKET
  BOX
  BOTTLE
  OTHER
}

// ─────────────────────────────────────────────
// ITEM  (individual SKU inside a product)
// ─────────────────────────────────────────────
model Item {
  id         String   @id @default(uuid())
  name       String
  price      Decimal  @db.Decimal(10, 2)
  unitType   UnitType
  stock      Decimal  @default(0) @db.Decimal(10, 3) // current inventory quantity
  productId  String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product   Product       @relation(fields: [productId], references: [id])
  category  Category      @relation(fields: [categoryId], references: [id])
  purchases PurchaseItem[]

  @@map("items")
}

// ─────────────────────────────────────────────
// CUSTOMER  (null user_id purchases = cash/walk-in)
// ─────────────────────────────────────────────
model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?  @unique
  address   String?
  balance   Decimal  @default(0) @db.Decimal(10, 2) // outstanding credit (positive = owes store)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases     Purchase[]
  purchaseItems PurchaseItem[]
  userCredit    UserCredit?

  @@map("customers")
}

// ─────────────────────────────────────────────
// PAYMENT TYPE (enum)
// ─────────────────────────────────────────────
enum PaymentType {
  CASH
  CREDIT
  MIXED // partial cash + partial credit
}

// ─────────────────────────────────────────────
// PURCHASE  (one bill / invoice)
// customerId NULL  → anonymous cash customer
// ─────────────────────────────────────────────
model Purchase {
  id                String      @id @default(uuid())
  customerId        String?     // NULL for anonymous cash purchases
  paymentType       PaymentType
  totalAmount       Decimal     @db.Decimal(10, 2)
  cashPayment       Decimal     @default(0) @db.Decimal(10, 2)
  creditPayment     Decimal     @default(0) @db.Decimal(10, 2)
  creditId          String?     // populated only when credit is involved
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer          Customer?        @relation(fields: [customerId], references: [id])
  userCredit        UserCredit?      @relation(fields: [creditId], references: [id])
  purchaseItems     PurchaseItem[]
  creditTransaction CreditTransaction?

  @@map("purchases")
}

// ─────────────────────────────────────────────
// PURCHASE ITEM  (line items on a bill)
// ─────────────────────────────────────────────
model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  itemId     String
  customerId String?  // denormalised for quick customer-history queries
  quantity   Decimal  @db.Decimal(10, 3) // respects unitType (kg, piece, etc.)
  size       String?  // optional e.g. "500ml", "Large"
  unitPrice  Decimal  @db.Decimal(10, 2) // price at time of purchase (snapshot)
  totalPrice Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  purchase Purchase  @relation(fields: [purchaseId], references: [id])
  item     Item      @relation(fields: [itemId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("purchase_items")
}

// ─────────────────────────────────────────────
// USER CREDIT  (credit account per customer)
// ─────────────────────────────────────────────
model UserCredit {
  id             String   @id @default(uuid())
  customerId     String   @unique
  totalBalance   Decimal  @default(0) @db.Decimal(10, 2) // total outstanding credit
  creditLimit    Decimal? @db.Decimal(10, 2)             // optional cap
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id])
  purchases         Purchase[]
  creditTransactions CreditTransaction[]

  @@map("user_credits")
}

// ─────────────────────────────────────────────
// TRANSACTION TYPE (enum)
// ─────────────────────────────────────────────
enum TransactionType {
  CREDIT_PURCHASE   // customer bought on credit  → balance increases
  CASH_REPAYMENT    // customer paid back cash    → balance decreases
  ADJUSTMENT        // manual correction by admin
}

// ─────────────────────────────────────────────
// CREDIT TRANSACTION  (ledger entry)
// ─────────────────────────────────────────────
model CreditTransaction {
  id            String          @id @default(uuid())
  userCreditId  String
  purchaseId    String?         @unique  // linked purchase (if any)
  customerId    String
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  balanceBefore Decimal         @db.Decimal(10, 2)
  balanceAfter  Decimal         @db.Decimal(10, 2)
  note          String?
  createdAt     DateTime        @default(now())

  userCredit UserCredit @relation(fields: [userCreditId], references: [id])
  purchase   Purchase?  @relation(fields: [purchaseId], references: [id])

  @@map("credit_transactions")
}
